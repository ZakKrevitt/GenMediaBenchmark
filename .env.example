# Copy this file to .env.local and fill in your own keys. .env.local is gitignored.

# fal: https://fal.ai/dashboard/keys
# Needed to run fal models. Without it the catalogue still lists, unpriced.
FAL_KEY=

# Higgsfield: https://cloud.higgsfield.ai/api-keys
# Use the "key_id:key_secret" pair. Needed to price and run Higgsfield models.
HIGGSFIELD_KEY=

# Optional: the AI judge scores finished renders with an OpenAI vision model.
# Set both to turn it on. LLM_MODEL is any OpenAI model that accepts images.
OPENAI_API_KEY=
LLM_MODEL=
# What one judge call reserves against the daily limit, in cents.
JUDGE_CENTS=5

# The most this app may spend per day across all renders, in US dollars.
DAILY_LIMIT_USD=20

# Where the local database and downloaded videos live.
DATA_DIR=.data
